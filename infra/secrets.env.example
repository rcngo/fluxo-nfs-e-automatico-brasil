# Chaves das APIs lidas pelo motor. Copiar para infra/secrets.env (fora do git) e preencher.
ANTHROPIC_API_KEY=
# Chave da NFE.io (conta de testes). A trava só deixa emitir no ambiente Development.
NFEIO_API_KEY=
# Empresa da NFE.io usada por "npm run teste:externo -- nfeio" (opcional)
NFEIO_COMPANY_ID=
# WhatsApp (Cloud API), só para testar o WhatsApp: App Secret do app na Meta e um token
# escolhido por você para a verificação do webhook (gerar com: openssl rand -hex 16)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Modelo do Claude (opcional; padrão em n8n/extrair.js)
# MODELO=claude-opus-5-5
