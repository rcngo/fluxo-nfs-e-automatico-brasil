# Máquina de desenvolvimento (infra/docker-compose.yml). Copiar para infra/.env e preencher.
# A instalação do escritório usa infra/producao/ (o instalador gera a configuração sozinho).
POSTGRES_USER=nfs
POSTGRES_PASSWORD=troque-esta-senha
# Gerar com: openssl rand -hex 32  (guardar em local seguro; sem ela as credenciais do n8n ficam ilegíveis)
N8N_ENCRYPTION_KEY=
# Endereço público do n8n (túnel), só para testar o WhatsApp. Vazio = http://localhost:5678/
N8N_WEBHOOK_URL=
